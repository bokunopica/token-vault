<Window x:Class="TokenVault.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenVault · 解锁" Height="490" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BgBrush}">
    <Grid Margin="36,28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TokenVault" Style="{StaticResource H1}"/>
            <TextBlock Text="令牌与密钥管家" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="ModeTitle" Style="{StaticResource H2}" Text="输入主密码以解锁"/>
                    <TextBlock x:Name="ModeHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"
                               Text="保险库使用 AES-256-GCM 加密存储在本机。"/>

                    <TextBlock Text="主密码" Style="{StaticResource Muted}"/>
                    <PasswordBox x:Name="PwdBox" Margin="0,4,0,0" KeyDown="PwdBox_KeyDown"/>
                    <TextBox x:Name="PwdBoxVisible" Margin="0,4,0,0" Visibility="Collapsed" KeyDown="PwdBox_KeyDown"/>

                    <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                        <TextBlock Text="确认主密码" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                        <PasswordBox x:Name="PwdConfirm" Margin="0,4,0,0" KeyDown="PwdBox_KeyDown"/>
                        <TextBox x:Name="PwdConfirmVisible" Margin="0,4,0,0" Visibility="Collapsed" KeyDown="PwdBox_KeyDown"/>
                    </StackPanel>

                    <CheckBox x:Name="ShowPwd" Content="显示密码（避免输错）" Margin="0,10,0,0"
                              Checked="ShowPwd_Changed" Unchecked="ShowPwd_Changed"/>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                    <Button x:Name="SubmitBtn" Style="{StaticResource BtnPrimary}" Margin="0,14,0,0"
                            Content="解锁" Click="Submit_Click"/>

                    <Button x:Name="ForgotBtn" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Padding="0" Content="忘记主密码？重置保险库"
                            Click="Forgot_Click" Visibility="Collapsed"/>

                    <TextBlock x:Name="Footnote" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="忘记主密码无法找回，请妥善保管。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
