<UserControl x:Class="TokenVault.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToLabelConverter x:Key="BoolToLabel" xmlns:local="clr-namespace:TokenVault.Views"/>
        <local:InverseBoolToVisConverter x:Key="InvBoolToVis" xmlns:local="clr-namespace:TokenVault.Views"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BtnPrimary}" Content="＋ 添加凭据" Click="Add_Click"/>
            </StackPanel>
        </Grid>

        <!-- 列表 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <ListView ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" x:Name="List">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding UsernameDisplay}" Style="{StaticResource Muted}" FontSize="11.5"
                                                   Visibility="{Binding HasUsername, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类别" Width="115">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryDisplay}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="密码" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PasswordDisplay}" FontFamily="Consolas" VerticalAlignment="Center"
                                                   MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                        <Button Content="{Binding IsPasswordRevealed, Converter={StaticResource BoolToLabel}}"
                                                Style="{StaticResource BtnSmall}" Margin="6,0,0,0"
                                                Tag="{Binding}" Click="RevealPassword_Click"/>
                                        <Button Content="复制" Style="{StaticResource BtnSmall}" Margin="4,0,0,0"
                                                Tag="{Binding}" Click="CopyPassword_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="API Key" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ApiKeyDisplay}" FontFamily="Consolas" VerticalAlignment="Center"
                                                   MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                        <Button Content="{Binding IsApiKeyRevealed, Converter={StaticResource BoolToLabel}}"
                                                Style="{StaticResource BtnSmall}" Margin="6,0,0,0"
                                                Tag="{Binding}" Click="RevealApiKey_Click"/>
                                        <Button Content="复制" Style="{StaticResource BtnSmall}" Margin="4,0,0,0"
                                                Tag="{Binding}" Click="CopyApiKey_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="地址" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UrlDisplay}" Style="{StaticResource Muted}" MaxWidth="140"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasClickableUrl, Converter={StaticResource InvBoolToVis}}"/>
                                        <TextBlock Visibility="{Binding HasClickableUrl, Converter={StaticResource BoolToVis}}"
                                                   MaxWidth="140" TextTrimming="CharacterEllipsis">
                                            <Hyperlink Click="Url_Click"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       ToolTip="在浏览器中打开">
                                                <Run Text="{Binding UrlDisplay, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="更新时间" Width="95">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedAtDisplay}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="操作" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="修改" Style="{StaticResource BtnSmall}" Tag="{Binding}" Click="Edit_Click"/>
                                        <Button Content="删除" Style="{StaticResource BtnSmall}" Margin="6,0,0,0"
                                                Foreground="{StaticResource DangerBrush}" Tag="{Binding}" Click="Delete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="还没有凭据" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="点击“＋ 添加凭据”录入 API Key、账号密码、数据库连接等任意登录信息"
                           Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
