<Window x:Class="TokenVault.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改主密码" Height="400" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BgBrush}">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="修改主密码" Style="{StaticResource H2}"/>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="当前主密码" Style="{StaticResource Muted}"/>
            <PasswordBox x:Name="PwCurrent" Margin="0,4,0,0"/>
            <TextBlock Text="新主密码（至少 6 位）" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
            <PasswordBox x:Name="PwNew" Margin="0,4,0,0"/>
            <TextBlock Text="确认新主密码" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
            <PasswordBox x:Name="PwConfirm" Margin="0,4,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="92" Click="Cancel_Click"/>
            <Button Style="{StaticResource BtnPrimary}" Width="130" Margin="12,0,0,0" Content="保存"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
