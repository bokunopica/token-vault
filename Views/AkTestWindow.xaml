<Window x:Class="TokenVault.Views.AkTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一次性校验 AccessKey（不写入保险库）" Height="470" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BgBrush}">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="一次性校验 AccessKey" Style="{StaticResource H2}"/>
            <TextBlock Text="直接把 RAM 控制台 / CSV 里的两个值粘进来测试，不写入保险库，也不会覆盖任何已保存的凭据。"
                       Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="AccessKey ID（LTAI…，24 位）" Style="{StaticResource Muted}"/>
            <TextBox x:Name="AkBox" Margin="0,4,0,0" FontFamily="Consolas"/>

            <TextBlock Text="AccessKey Secret（30 位）" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
            <Grid Margin="0,4,0,0">
                <PasswordBox x:Name="SkBox" FontFamily="Consolas"/>
                <TextBox x:Name="SkVisible" FontFamily="Consolas" Visibility="Collapsed"/>
            </Grid>
            <CheckBox x:Name="ShowSk" Content="显示 Secret" Margin="0,8,0,0" Checked="ShowSk_Changed" Unchecked="ShowSk_Changed"/>
            <TextBlock Text="提示：从 RAM 控制台创建 AccessKey 时点「下载 CSV」，两个值在同一行，最不容易串。"
                       Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Text="尚未测试。点下面的「测试密钥」调 STS GetCallerIdentity 验证这一对是否有效。"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="关闭" Width="92" Click="Close_Click"/>
            <Button x:Name="TestBtn" Style="{StaticResource BtnPrimary}" Width="120" Margin="12,0,0,0"
                    Content="测试密钥" Click="Test_Click"/>
            <Button x:Name="SaveBtn" Style="{StaticResource BtnGhost}" Width="150" Margin="12,0,0,0"
                    Content="通过并保存到凭据" IsEnabled="False" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
