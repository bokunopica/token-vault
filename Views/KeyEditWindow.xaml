<Window x:Class="TokenVault.Views.KeyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凭据" Height="760" Width="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BgBrush}">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource H2}"/>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称 *" Style="{StaticResource Muted}"/>
                <TextBox x:Name="NameBox" Margin="0,4,0,0"/>

                <TextBlock Text="类别" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                <ComboBox x:Name="CategoryBox" Margin="0,4,0,0" DisplayMemberPath="Display"/>

                <TextBlock Text="地址 / Base URL（可选）" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                <TextBox x:Name="BaseUrlBox" Margin="0,4,0,0" FontFamily="Consolas"/>
                <TextBlock Text="MiMo / DeepSeek 类别留空时使用官方默认地址；其他类别可填网站、控制台或主机地址"
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="用户名（可选）" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                <TextBox x:Name="UsernameBox" Margin="0,4,0,0"/>

                <TextBlock Text="密码（可选）" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                <PasswordBox x:Name="PwdBox" Margin="0,4,0,0" FontFamily="Consolas"/>
                <TextBox x:Name="PwdBoxVisible" Margin="0,4,0,0" FontFamily="Consolas" Visibility="Collapsed"/>

                <TextBlock Text="API Key（可选）" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                <TextBox x:Name="KeyBox" Margin="0,4,0,0" FontFamily="Consolas" Visibility="Collapsed"/>
                <PasswordBox x:Name="KeyPwBox" Margin="0,4,0,0" FontFamily="Consolas"/>

                <CheckBox x:Name="ShowKeyCheck" Content="显示密码与 API Key" Margin="0,8,0,0"
                          Checked="ShowKey_Changed" Unchecked="ShowKey_Changed"/>

                <TextBlock Text="自定义字段（可添加任意键值，如 DATABASE_URL、PGWEB_AUTH_USER 等）"
                           Style="{StaticResource Muted}" Margin="0,14,0,0"/>
                <ItemsControl x:Name="FieldsHost" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="38"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas"/>
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0,0,0" FontFamily="Consolas"/>
                                <Button Grid.Column="2" Content="✕" Margin="6,0,0,0" Padding="0"
                                        Style="{StaticResource BtnSmall}" Tag="{Binding}" Click="RemoveField_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋ 添加字段" Style="{StaticResource BtnSmall}" HorizontalAlignment="Left"
                        Margin="0,6,0,0" Click="AddField_Click"/>

                <TextBlock Text="备注（可选）" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                <TextBox x:Name="NoteBox" Margin="0,4,0,0" AcceptsReturn="True" Height="56"
                         TextWrapping="Wrap" VerticalContentAlignment="Top"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="TestBtn" Content="测试连接" Click="Test_Click"/>
                <TextBlock x:Name="TestStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"
                           Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="380"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Width="92" Click="Cancel_Click"/>
                <Button x:Name="SaveBtn" Style="{StaticResource BtnPrimary}" Width="130" Margin="12,0,0,0"
                        Content="保存" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
