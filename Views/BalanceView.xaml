<UserControl x:Class="TokenVault.Views.BalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Style="{StaticResource BtnPrimary}" Content="立即刷新" Command="{Binding RefreshAllCommand}"/>
            <CheckBox Content="自动刷新" IsChecked="{Binding AutoRefresh}" Margin="18,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource Muted}" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 双卡片 -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MiMo Token Plan -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="MiMo Token Plan" Style="{StaticResource H2}"/>
                    <TextBlock Text="使用程度 · tp- 密钥 · /platform/token_plan" Style="{StaticResource Muted}" Margin="0,3,0,0"/>

                    <TextBlock Text="查询密钥" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
                    <ComboBox ItemsSource="{Binding MimoKeys}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedMimoKey}" Margin="0,5,0,0"/>

                    <TextBlock Text="{Binding MimoPct}" Style="{StaticResource Big}" Margin="0,20,0,0"/>
                    <ProgressBar Style="{StaticResource Progress}" Value="{Binding MimoProgress}" Maximum="100" Margin="0,10,0,0"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="已用" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding MimoUsed}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="总量" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding MimoTotal}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="剩余" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding MimoRemaining}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MimoPeriod}" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding MimoPlanCode}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding MimoAutoRenew}" Style="{StaticResource Muted}" Margin="16,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding MimoCons}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="查询" Command="{Binding QueryMimoCommand}" Style="{StaticResource BtnPrimary}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding MimoStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- DeepSeek -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="DeepSeek 余额" Style="{StaticResource H2}"/>
                    <TextBlock Text="账户余额 · sk- 密钥 · /user/balance" Style="{StaticResource Muted}" Margin="0,3,0,0"/>

                    <TextBlock Text="查询密钥" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
                    <ComboBox ItemsSource="{Binding DsKeys}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedDsKey}" Margin="0,5,0,0"/>

                    <TextBlock Text="{Binding DsTotal}" Style="{StaticResource Big}" Margin="0,20,0,0"/>
                    <TextBlock Text="{Binding DsAvailable}" Margin="0,6,0,0" FontWeight="SemiBold"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="赠送余额" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding DsGranted}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="充值余额" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding DsTopped}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding DsCons}" Style="{StaticResource Muted}" Margin="0,16,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="查询" Command="{Binding QueryDsCommand}" Style="{StaticResource BtnPrimary}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DsStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 阿里云百炼 Token 套餐 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="阿里云百炼 Token 套餐" Style="{StaticResource H2}"/>
                    <TextBlock Text="余量查询 · 用「阿里云 AccessKey（AK/SK）」走官方 OpenAPI（AK 填账号、SK 填密码）"
                               Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding AliKeys}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedAliKey}" Margin="0,14,0,0"
                              MaxWidth="420" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding AliStatus}" Margin="0,10,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AliStatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding AliRaw}" Style="{StaticResource Muted}" FontFamily="Consolas"
                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="64"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="{Binding AliPct}" Style="{StaticResource Big}"/>
                    <ProgressBar Style="{StaticResource Progress}" Value="{Binding AliProgress}" Maximum="100" Margin="0,10,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="已用" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding AliUsed}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="总量" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding AliTotal}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="剩余" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding AliRemaining}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding AliPeriod}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding AliPlanCode}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="查询" Command="{Binding QueryAliCommand}" Style="{StaticResource BtnPrimary}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
