<Window x:Class="TokenVault.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Height="360" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource BgBrush}">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource H2}"/>
        <TextBlock Grid.Row="1" x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13.5"
                   LineHeight="22"/>

        <StackPanel Grid.Row="2" x:Name="TypedPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock x:Name="TypedHint" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            <TextBox x:Name="TypedBox" Margin="0,6,0,0" FontFamily="Consolas"
                     TextChanged="TypedBox_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="取消" Width="92" Click="Cancel_Click"/>
            <Button x:Name="ConfirmBtn" Style="{StaticResource BtnDanger}" Width="130" Margin="12,0,0,0"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
